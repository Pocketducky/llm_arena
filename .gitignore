# Байт-код Python
__pycache__/
*.pyc

# Локальная конфигурация окружения (реальные адреса/ключи vLLM).
# В репозитории остаётся только .env.example — шаблон.
.env

# Виртуальные окружения
.venv/
venv/
env/

# Логи (включая evaluation.log и любые прогонные логи)
*.log

# Системный мусор ОС
.DS_Store
Thumbs.db

# Временные файлы Excel (lock-файлы при открытом редакторе)
~$*.xlsx
~$*.xls

# Временные файлы скриптов мониторинга/отладки
tmp_*.txt

# Артефакты прогонов — содержат фрагменты реальных ЭМК/суммаризаций
# (вердикты судей с цитатами, контекстом и т.п.) — НЕ для публичного репозитория
audit_log/
checkpoints/
reports/
results/
*.zip
