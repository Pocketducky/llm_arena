# ─────────────────────────────────────────────────────────────────────────
# Пример конфигурации окружения для запуска в НПКЦ через vLLM.
#
# КАК ПОЛЬЗОВАТЬСЯ:
#   1) скопируйте этот файл в `.env`  (cp .env.example .env)
#   2) впишите реальные адреса и имена моделей вашего vLLM
#   3) запустите  python check_environment.py
# Файл `.env` подхватывается автоматически (config.py). Уже заданные через
# `export` переменные имеют приоритет над `.env`.
# ─────────────────────────────────────────────────────────────────────────

# Бэкенд LLM: vllm (продакшн НПКЦ) или ollama (локальная разработка).
EMR_LLM_BACKEND=vllm

# Профиль «роль → модель». Для НПКЦ — npkc:
#   judge_1, judge_2 = крупная модель; judge_3 = средняя; aggregator = крупная.
EMR_PROFILE=npkc

# ── Имена моделей ──────────────────────────────────────────────────────────
# ВАЖНО: должны ТОЧНО совпадать с --served-model-name вашего vLLM
# (проверить: curl http://<адрес>/v1/models). Иначе vLLM вернёт 404.
EMR_MODEL_LARGE=qwen3.5-122b-fp8
EMR_MODEL_MEDIUM=qwen3.6-27b-fp8

# ── Адреса vLLM ────────────────────────────────────────────────────────────
# Общий адрес по умолчанию (если ОДИН сервер/шлюз обслуживает обе модели):
EMR_VLLM_BASE_URL=http://localhost:8000/v1
# vLLM по умолчанию не требует ключа; впишите токен, если API закрыт.
EMR_VLLM_API_KEY=EMPTY

# Если КАЖДАЯ модель на своём сервере/порту (типичный случай для vLLM) —
# укажите отдельные адреса; тогда EMR_VLLM_BASE_URL можно не использовать:
# EMR_VLLM_ENDPOINT_LARGE=http://localhost:8000/v1
# EMR_VLLM_ENDPOINT_MEDIUM=http://localhost:8001/v1

# ── Параметры генерации / надёжности ──────────────────────────────────────
# Таймаут одного запроса, сек (крупные модели медленнее — держите с запасом).
EMR_TIMEOUT=600
# Верхняя граница длины ответа (vLLM: max_tokens).
EMR_MAX_TOKENS=1536
# Температура (0.1 — почти детерминированно, как в дизайне).
EMR_TEMPERATURE=0.1
# Пауза между запросами, сек (щадит сервер).
EMR_REQUEST_PAUSE=2

# Режим «мышления» Qwen3. По умолчанию 0 (выключено) — это важно для
# надёжности JSON: скрытые рассуждения съедают бюджет и обрывают ответ.
EMR_VLLM_ENABLE_THINKING=0

# Тип задачи суммаризаций текущего датасета (radiologist — целевые выжимки
# для рентгенолога; пусто — общая сводка по 5 разделам).
EMR_DATASET_SCOPE=radiologist

# ── Локальная разработка через Ollama (нужно только при EMR_LLM_BACKEND=ollama) ──
# EMR_OLLAMA_HOST=http://localhost:11434
# EMR_OLLAMA_NUM_CTX=16384
