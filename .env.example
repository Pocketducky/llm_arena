# ─────────────────────────────────────────────────────────────────────────
# Пример конфигурации окружения для запуска в НПКЦ через vLLM.
#
# КАК ПОЛЬЗОВАТЬСЯ:
#   1) скопируйте этот файл в `.env`  (cp .env.example .env)
#   2) впишите реальные адреса и имена моделей вашего vLLM
#   3) запустите  python check_environment.py
# Файл `.env` подхватывается автоматически (config.py). Уже заданные через
# `export` переменные имеют приоритет над `.env`.
# ─────────────────────────────────────────────────────────────────────────

# Бэкенд LLM: vllm (продакшн НПКЦ) или ollama (локальная разработка).
EMR_LLM_BACKEND=vllm

# Профиль «роль → модель». Для НПКЦ — npkc:
#   judge_1, judge_2 = крупная модель; judge_3 = средняя; aggregator = крупная.
EMR_PROFILE=npkc

# ── Имена моделей ──────────────────────────────────────────────────────────
# ВАЖНО: должны ТОЧНО совпадать с --served-model-name вашего vLLM
# (проверить: curl http://<адрес>/v1/models). Иначе vLLM вернёт 404.
EMR_MODEL_LARGE=qwen3.5-122b-fp8
EMR_MODEL_MEDIUM=qwen3.6-27b-fp8

# ── Адреса vLLM ────────────────────────────────────────────────────────────
# Общий адрес по умолчанию (если ОДИН сервер/шлюз обслуживает обе модели):
EMR_VLLM_BASE_URL=http://localhost:8000/v1
# vLLM по умолчанию не требует ключа; впишите токен, если API закрыт.
EMR_VLLM_API_KEY=EMPTY

# Если КАЖДАЯ модель на своём сервере/порту (типичный случай для vLLM) —
# укажите отдельные адреса; тогда EMR_VLLM_BASE_URL можно не использовать:
# EMR_VLLM_ENDPOINT_LARGE=http://localhost:8000/v1
# EMR_VLLM_ENDPOINT_MEDIUM=http://localhost:8001/v1

# ── Параметры генерации / надёжности ──────────────────────────────────────
# Таймаут одного запроса, сек (крупные модели медленнее — держите с запасом).
EMR_TIMEOUT=600
# Температура. 0 — детерминированно; вместе с EMR_SEED даёт воспроизводимый прогон.
EMR_TEMPERATURE=0.0
# Seed прогона (влияет и на порядок судей в R2/R3).
EMR_SEED=42
# Пауза между запросами, сек. При включённом параллелизме можно 0.
EMR_REQUEST_PAUSE=2
# Сколько пар обрабатывать параллельно (внутри пары порядок R1->R2->R3 сохраняется).
EMR_CONCURRENCY=4

# ── Бюджеты длины ответа (в токенах) ──────────────────────────────────────
# ВАЖНО: единый бюджет 1024-1536 был причиной ошибки «JSON собран салважем…
# ответ был оборван». Бюджет должен быть соразмерен ОЖИДАЕМОМУ ОТВЕТУ, а не
# одинаков для всех раундов. 1536 токенов ≈ 3000-3800 символов русского JSON.
EMR_MAX_TOKENS=4096              # база (всё, где не задан раунд)
EMR_MAX_TOKENS_R1=3072           # раунд 1, блоки A / C / D
EMR_MAX_TOKENS_R1_LARGE=4096     # раунд 1, блоки B и E (вложенные списки)
EMR_MAX_TOKENS_R2=8192           # раунд 2 — переиздание всего отчёта A-E
EMR_MAX_TOKENS_R3=6144           # раунд 3 — вердикт + сводка по 5 блокам
EMR_MAX_TOKENS_ENTITIES=4096     # извлечение сущностей и фильтр релевантности
# Потолок автоподъёма: при обрыве ответа бюджет удваивается до этого значения.
EMR_MAX_TOKENS_CEILING=16384

# ── Пороги решений ────────────────────────────────────────────────────────
# E1 засчитывается, только если судья привёл конкретный фрагмент суммаризации
# и этот фрагмент в ней действительно есть (проверяет код). 0 — прежнее
# поведение «любой поднятый флаг = E1» (для A/B-сравнения).
EMR_E1_REQUIRE_CITATION=1
# Сколько блоков таксономии могут остаться без данных, прежде чем оценка
# признаётся НЕПОЛНОЙ (а не «Неприемлемо» — это разные вещи).
EMR_MAX_NODATA_BLOCKS=1

# ── Извлечение сущностей из длинных ЭМК ───────────────────────────────────
# Раньше текст жёстко резался на 6000 символах: на прод-корпусе (медиана
# исходника 21107 симв.) терялось ~72 % карты, и entity_recall шлюза считался
# по первой трети. Длинные тексты режутся на перекрывающиеся куски.
EMR_ENTITY_MAX_CHARS=40000
EMR_ENTITY_CHUNK_CHARS=12000
EMR_ENTITY_CHUNK_OVERLAP=500

# Режим «мышления» Qwen3. По умолчанию 0 (выключено) — это важно для
# надёжности JSON: скрытые рассуждения съедают бюджет и обрывают ответ.
EMR_VLLM_ENABLE_THINKING=0

# Тип задачи суммаризаций текущего датасета (radiologist — целевые выжимки
# для рентгенолога; пусто — общая сводка по 5 разделам).
EMR_DATASET_SCOPE=radiologist

# ── Локальная разработка через Ollama (нужно только при EMR_LLM_BACKEND=ollama) ──
# EMR_OLLAMA_HOST=http://localhost:11434
# EMR_OLLAMA_NUM_CTX=16384
